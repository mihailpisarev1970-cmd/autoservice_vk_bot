# Токен сообщества ВКонтакте (Управление → Работа с API → Ключи доступа)
VK_TOKEN=your_vk_group_access_token

# Шлюз Polza.ai (OpenAI-совместимый API)
POLZA_API_KEY=pza_your_api_key
POLZA_BASE_URL=https://api.polza.ai/v1
AI_MODEL=openai/gpt-4o-mini

# Настройки Baserow
BASEROW_URL=https://your-baserow-instance.com
BASEROW_TOKEN=your_baserow_token
BASEROW_TABLE_ID=278
